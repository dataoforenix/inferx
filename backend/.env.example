# OpenAI — required for live mode (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Model IDs. gpt-4o-mini is recommended for both: vision + JSON structured outputs.
NORMALIZE_MODEL=gpt-4o-mini
EXPLAIN_MODEL=gpt-4o-mini

# Reasoning effort per call: low | medium | high
NORMALIZE_EFFORT=low
EXPLAIN_EFFORT=medium

# Offline / Demo Mode (serves prepared demo_cache examples, no OpenAI calls)
DEMO_MODE=false

# CORS — comma-separated origins or * for any
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Data paths (relative to backend/ or absolute)
CATEGORIES_CSV=data/categories.csv
DEMO_CACHE_DIR=data/demo_cache

# Input limits
MAX_UPLOAD_MB=8
MAX_TEXT_CHARS=1000
CONFIRM_CONFIDENCE_THRESHOLD=0.7

# Pipeline timeouts and retries
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_REFUSAL_FALLBACK=true

# UN Comtrade market preview for physical products outside the categories (live mode only)
# Adds up to ~10 s to such requests; set false to disable.
MARKET_PREVIEW=true

# Per-client-IP rate limit on POST /api/analyze and /api/analyze/confirm (in-memory, per process)
# 0 disables. Behind a dev proxy every browser shares the proxy IP; use ~300 while rehearsing.
RATE_LIMIT_PER_MINUTE=30

# Logging
LOG_LEVEL=INFO
