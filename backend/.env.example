# The backend uses the OpenAI Python SDK against Google Gemini's OpenAI-compatible endpoint.
# OPENAI_API_KEY holds a Gemini API key (https://aistudio.google.com/apikey). Required for live mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model IDs (must support vision + JSON structured outputs on that endpoint).
# gemini-3.5-flash-lite at effort "low" was measured at 1.2-1.9 s per call; gemini-3.8-flash at 12-120+ s.
NORMALIZE_MODEL=gemini-3.5-flash-lite
EXPLAIN_MODEL=gemini-3.5-flash-lite
# Sent as reasoning_effort on both calls ("low" by default; "default" = don't send it).
# In testing, gemini-3.8-flash failed immediately with "minimal".
LLM_REASONING_EFFORT=low

# Offline / Demo Mode (serves prepared demo_cache examples, no LLM calls, no key needed)
DEMO_MODE=false

# CORS — comma-separated origins or * for any
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Data paths (relative to backend/ or absolute)
CATEGORIES_CSV=data/categories.csv
DEMO_CACHE_DIR=data/demo_cache

# Input limits
MAX_UPLOAD_MB=8
MAX_TEXT_CHARS=1000
CONFIRM_CONFIDENCE_THRESHOLD=0.7

# Pipeline timeouts and retries
# Per-call timeout and SDK retries: a stuck call is cut off at 15 s and retried once.
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1

# UN Comtrade market preview for physical products outside the categories (live mode only)
# Adds up to ~10 s to such requests; set false to disable.
MARKET_PREVIEW=true

# Per-client-IP rate limit on POST /api/analyze and /api/analyze/confirm (in-memory, per process)
# 0 disables. Behind a dev proxy every browser shares the proxy IP; use ~300 while rehearsing.
RATE_LIMIT_PER_MINUTE=30

# Logging
LOG_LEVEL=INFO

# Optional SQLite response cache + search counter (Python's built-in sqlite3; never used in DEMO_MODE).
# DB_ENABLED=false turns it off completely (responses then have no "cache" field and /api/searches/top doesn't exist).
DB_ENABLED=true
DB_PATH=data/sannaha.db
CACHE_TTL_HOURS=24
