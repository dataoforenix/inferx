  "components": {
    "schemas": {
      "AnalyzeResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "needs_confirmation",
              "unsupported",
              "market_preview"
            ],
            "title": "Status"
          },
          "language": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ],
            "title": "Language"
          },
          "source": {
            "type": "string",
            "enum": [
              "live",
              "demo_cache"
            ],
            "title": "Source",
            "default": "live"
          },
          "product": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NormalizedProduct"
              },
              {
                "type": "null"
              }
            ]
          },
          "needs_confirmation": {
            "type": "boolean",
            "title": "Needs Confirmation"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CategoryCandidate"
            },
            "type": "array",
            "title": "Candidates",
            "description": "Categories the user can confirm via /api/analyze/confirm when needs_confirmation is true."
          },
          "report": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FeasibilityReport"
              },
              {
                "type": "null"
              }
            ]
          },
          "explanation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Explanation"
              },
              {
                "type": "null"
              }
            ]
          },
          "explanation_source": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "llm",
                  "fallback",
                  "template"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation Source",
            "description": "llm: AI-written and grounding-checked; fallback: template used because the AI text was unavailable or ungrounded; template: deterministic text by design (market_preview)."
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "timings_ms": {
            "$ref": "#/components/schemas/Timings"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "status",
          "language",
          "product",
          "needs_confirmation",
          "candidates",
          "report",
          "explanation",
          "explanation_source",
          "warnings"
        ],
        "title": "AnalyzeResponse"
      },
      "Body_analyze_api_analyze_post": {
        "properties": {
          "image": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image",
            "description": "JPEG, PNG or WebP, max 8 MB"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text",
            "description": "Product description in Arabic or English"
          },
          "language": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ],
            "title": "Language",
            "default": "en"
          }
        },
        "type": "object",
        "title": "Body_analyze_api_analyze_post"
      },
      "BreakEven": {
        "properties": {
          "capex_mid_usd": {
            "type": "number",
            "title": "Capex Mid Usd",
            "description": "(capex_usd_range.min + max) / 2, USD"
          },
          "unit_saving_usd_per_kg": {
            "type": "number",
            "title": "Unit Saving Usd Per Kg",
            "description": "landed import cost - local cost, USD/kg"
          },
          "break_even_tons": {
            "type": "number",
            "title": "Break Even Tons",
            "description": "capex_mid_usd / unit_saving_usd_per_kg, in tonnes"
          },
          "share_of_2024_imports": {
            "type": "number",
            "title": "Share Of 2024 Imports",
            "description": "break-even weight / import_weight_kg_2024, as a fraction"
          }
        },
        "type": "object",
        "required": [
          "capex_mid_usd",
          "unit_saving_usd_per_kg",
          "break_even_tons",
          "share_of_2024_imports"
        ],
        "title": "BreakEven",
        "description": "How much must be sold at import-parity price before the equipment pays for itself."
      },
      "CapexRange": {
        "properties": {
          "min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min",
            "description": "Equipment only: supplier listing prices ex-works, excluding shipping, customs, installation, moulds and buildings (USD)."
          },
          "max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max",
            "description": "Equipment only: supplier listing prices ex-works, excluding shipping, customs, installation, moulds and buildings (USD)."
          }
        },
        "type": "object",
        "required": [
          "min",
          "max"
        ],
        "title": "CapexRange"
      },
      "CategoriesResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "categories": {
            "items": {
              "$ref": "#/components/schemas/CategorySummary"
            },
            "type": "array",
            "title": "Categories"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "categories"
        ],
        "title": "CategoriesResponse"
      },
      "CategoryCandidate": {
        "properties": {
          "category_id": {
            "type": "string",
            "title": "Category Id"
          },
          "name_en": {
            "type": "string",
            "title": "Name En"
          },
          "name_ar": {
            "type": "string",
            "title": "Name Ar"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "category_id",
          "name_en",
          "name_ar"
        ],
        "title": "CategoryCandidate"
      },
      "CategorySummary": {
        "properties": {
          "category_id": {
            "type": "string",
            "title": "Category Id"
          },
          "name_en": {
            "type": "string",
            "title": "Name En"
          },
          "name_ar": {
            "type": "string",
            "title": "Name Ar"
          },
          "description_en": {
            "type": "string",
            "title": "Description En"
          },
          "hs6": {
            "type": "string",
            "title": "Hs6"
          },
          "data_status": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "ESTIMATE",
              "TODO_REAL_DATA"
            ],
            "title": "Data Status"
          },
          "is_placeholder_data": {
            "type": "boolean",
            "title": "Is Placeholder Data",
            "description": "True when values are TODO_REAL_DATA placeholders."
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Fields"
          }
        },
        "type": "object",
        "required": [
          "category_id",
          "name_en",
          "name_ar",
          "description_en",
          "hs6",
          "data_status",
          "is_placeholder_data",
          "missing_fields"
        ],
        "title": "CategorySummary"
      },
      "CompetitionBreakdown": {
        "properties": {
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "local_factories": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Factories"
          },
          "factories_saturation": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Factories Saturation"
          }
        },
        "type": "object",
        "required": [
          "score",
          "local_factories",
          "factories_saturation"
        ],
        "title": "CompetitionBreakdown"
      },
      "ConfirmRequest": {
        "properties": {
          "category_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Category Id"
          },
          "language": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ],
            "title": "Language",
            "default": "en"
          },
          "product": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProductInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "category_id"
        ],
        "title": "ConfirmRequest"
      },
      "CostBreakdown": {
        "properties": {
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "import_price_per_kg_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Import Price Per Kg Usd"
          },
          "shipping_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shipping Pct"
          },
          "customs_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customs Pct"
          },
          "landed_cost_per_kg_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Landed Cost Per Kg Usd"
          },
          "local_cost_per_kg_est_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Cost Per Kg Est Usd"
          },
          "margin": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Margin",
            "description": "(landed - local) / landed, as a fraction"
          },
          "raw_material_price_usd_per_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Material Price Usd Per Kg"
          },
          "material_kg_per_kg_product": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Material Kg Per Kg Product"
          },
          "conversion_cost_per_kg_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversion Cost Per Kg Usd"
          }
        },
        "type": "object",
        "required": [
          "score",
          "import_price_per_kg_usd",
          "shipping_pct",
          "customs_pct",
          "landed_cost_per_kg_usd",
          "local_cost_per_kg_est_usd",
          "margin"
        ],
        "title": "CostBreakdown"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Explanation": {
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ],
            "title": "Language"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "reasons_for": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons For"
          },
          "concerns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Concerns"
          },
          "next_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Next Steps"
          },
          "caveats": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Caveats"
          }
        },
        "type": "object",
        "required": [
          "language",
          "summary",
          "reasons_for",
          "concerns",
          "next_steps",
          "caveats"
        ],
        "title": "Explanation"
      },
