          },
          "skills_availability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Skills Availability"
          }
        },
        "type": "object",
        "required": [
          "score",
          "machinery_availability",
          "raw_material_local",
          "skills_availability"
        ],
        "title": "FeasibilityBreakdown"
      },
      "FeasibilityReport": {
        "properties": {
          "category_id": {
            "type": "string",
            "title": "Category Id"
          },
          "name_en": {
            "type": "string",
            "title": "Name En"
          },
          "name_ar": {
            "type": "string",
            "title": "Name Ar"
          },
          "hs6": {
            "type": "string",
            "title": "Hs6"
          },
          "data_status": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "ESTIMATE",
              "TODO_REAL_DATA"
            ],
            "title": "Data Status"
          },
          "is_placeholder_data": {
            "type": "boolean",
